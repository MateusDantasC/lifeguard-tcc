{
  "expo": {
    "name": "LifeGuard",
    "slug": "lifeguard-tcc",
    "scheme": "lifeguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lifeguard-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/lifeguard-mark.png",
        "backgroundColor": "#1B3A3F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/lifeguard-icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "image": "./assets/lifeguard-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
