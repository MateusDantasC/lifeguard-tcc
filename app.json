{
  "expo": {
    "name": "LifeGuard",
    "slug": "lifeguard-tcc",
    "scheme": "lifeguard",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/lifeguard-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mdantasc.lifeguard"
    },
    "android": {
      "package": "com.mdantasc.lifeguard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/lifeguard-mark.png",
        "backgroundColor": "#1B3A3F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/lifeguard-icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O LifeGuard usa a foto escolhida por você no seu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "image": "./assets/lifeguard-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "92c95f11-213c-4abb-80d7-530ac17bfcdb"
      }
    },
    "owner": "mdantasc",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/92c95f11-213c-4abb-80d7-530ac17bfcdb",
      "checkAutomatically": "NEVER"
    }
  }
}
